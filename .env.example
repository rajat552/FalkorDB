# FalkorDB Connection
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=company_brain
FALKORDB_PASSWORD=

# Optional LLM API Keys (Leave empty for deterministic local engine)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=auto
DEFAULT_OPENAI_MODEL=gpt-4o
DEFAULT_GEMINI_MODEL=gemini-1.5-flash-001

# Ingestion Settings
MAX_FILE_SIZE_MB=10
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150

# Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000